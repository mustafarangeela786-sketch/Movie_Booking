# Copy this file to ".env" (same folder) and fill in your real Gmail details.
# NEVER share your real .env file publicly.

# ---- SMTP transport ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_ENCRYPTION=tls
SMTP_USERNAME=your-email@gmail.com
# Gmail requires a 16-character "App Password", NOT your normal Gmail password.
# 1. Turn on 2-Step Verification on your Google account.
# 2. Generate an App Password at: https://myaccount.google.com/apppasswords
# 3. Paste that 16-character code below (no spaces).
SMTP_PASSWORD=your-16-char-app-password

# ---- From / Reply-To shown to the customer ----
MAIL_FROM_ADDRESS=your-email@gmail.com
MAIL_FROM_NAME=MovieBook

# ---- Company info shown in the confirmation email ----
COMPANY_NAME=MovieBook
SUPPORT_EMAIL=support@moviebook.com
SUPPORT_PHONE=+92 300 1234567
